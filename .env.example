DATABASE_URL="mysql://user:password@host:3306/dbname"
# Atau pakai variabel terpisah:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=secret
# DB_NAME=bpn_jakbar

# Lokasi penyimpanan file PDF pengamanan (relative atau absolute)
FILE_STORAGE_DIR="./uploads"

# Secret untuk HMAC-sign URL download file (>= 16 karakter, random)
SIGNED_URL_SECRET="ganti-dengan-string-random-min-32-karakter"

# API key Resend untuk pengiriman email status peminjaman
RESEND_API_KEY=""
