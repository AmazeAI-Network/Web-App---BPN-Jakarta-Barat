# --- Database (MySQL) ---
# Either set a single connection URL...
DATABASE_URL="mysql://user:password@host:3306/bpn_jakbar"
# ...or use discrete variables (DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME).

# --- File storage (PDF pengamanan) ---
# Folder on disk to keep uploaded PDFs. Created automatically.
FILE_STORAGE_DIR="./uploads"

# --- Secrets ---
# HMAC secret used to sign session cookies AND short-lived file URLs (min 32 chars random).
SIGNED_URL_SECRET="ganti-dengan-string-random-min-32-karakter"
# Optional: dedicated secret for sessions (falls back to SIGNED_URL_SECRET).
# SESSION_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="BPN Jakarta Barat <noreply@bpnjakbar.xyz>"
