APP_NAME="BPN Jakbar API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://api-arsip.bpnjakbar.id

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bpn_jakbar
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=720

# Domain SPA + API dipisah subdomain; SESSION_DOMAIN harus parent domain
SANCTUM_STATEFUL_DOMAINS=arsip.bpnjakbar.id,www.arsip.bpnjakbar.id,api-arsip.bpnjakbar.id
SESSION_DOMAIN=.bpnjakbar.id

# Frontend SPA origin (untuk CORS)
FRONTEND_URL=https://arsip.bpnjakbar.id

# Storage folder file PDF pengamanan
PENGAMANAN_DISK=pengamanan

# Backup data penting: lokal terenkripsi aktif default, database kedua opsional
DATA_BACKUP_ENABLED=true
DATA_BACKUP_LOCAL_ENABLED=true
DATA_BACKUP_LOCAL_PATH=
BACKUP_DB_ENABLED=false
BACKUP_DB_CONNECTION=mysql_backup
BACKUP_DB_HOST=127.0.0.1
BACKUP_DB_PORT=3306
BACKUP_DB_DATABASE=bpn_jakbar_backup
BACKUP_DB_USERNAME=root
BACKUP_DB_PASSWORD=

# Database staging untuk uji restore (Restore uji)
# Buat database terpisah lalu jalankan: php artisan migrate --database=mysql_staging --force
STAGING_DB_ENABLED=false
STAGING_DB_HOST=127.0.0.1
STAGING_DB_PORT=3306
STAGING_DB_DATABASE=bpn_jakbar_staging
STAGING_DB_USERNAME=root
STAGING_DB_PASSWORD=

# Backup penuh per jam (DB + file pengamanan)
BACKUP_FULL_ENABLED=true
BACKUP_FULL_PATH=
BACKUP_FILES_ROOT=
MYSQLDUMP_BIN=mysqldump
# Retensi otomatis (jam). Default 168 jam = 7 hari. Set 1 untuk retensi 1 jam.
BACKUP_RETENTION_HOURS=168

# Tujuan kedua: S3 / MinIO / Cloudflare R2 / Wasabi
S3_BACKUP_ENABLED=false
S3_BACKUP_KEY=
S3_BACKUP_SECRET=
S3_BACKUP_REGION=auto
S3_BACKUP_BUCKET=
S3_BACKUP_ENDPOINT=
S3_BACKUP_PATH_STYLE=true
S3_BACKUP_PREFIX=bpn-jakbar

# Resend email
RESEND_API_KEY=
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="no-reply@bpnjakbar.id"
MAIL_FROM_NAME="${APP_NAME}"
